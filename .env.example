# --- backend ---
DATABASE_URL=sqlite:///./ecommerce.db
# Postgres (docker/prod): postgresql://nova:nova@localhost:5432/nova
SECRET_KEY=dev-secret-change-in-production-please-override
REFRESH_SECRET_KEY=dev-refresh-secret-change-in-production
CORS_ORIGINS=http://localhost:3000
# Google ADK / Gemini (optional — agent falls back to local planner without it)
GOOGLE_API_KEY=
GOOGLE_GENAI_MODEL=gemini-2.0-flash
AGENT_MODEL=
DEMO_PASSWORD=password123

# --- frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
